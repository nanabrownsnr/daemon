    "uat:analyze": "node scripts/analyze-judgment-uat.js",
    "prepack": "npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^16.0.0"
  }
}
